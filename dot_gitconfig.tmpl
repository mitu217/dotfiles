[user]
    name = {{ .name }}
    email = {{ .email }}
    signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIBFGJmxfEwmuRnTBfydokHUHKXo2reuPF+nGgeuQcBVt

[gpg]
    format = ssh

[gpg "ssh"]
    program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"

[commit]
    gpgsign = true

[tag]
    gpgsign = true

[url "ssh://git@github.com/"]
    insteadOf = https://github.com/

[init]
    defaultBranch = main
